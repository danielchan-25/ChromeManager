[Unit]
Description=ChromeManager Chrome instance %i
After=network.target chromemanager-display.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
ExitType=cgroup
EnvironmentFile=%h/.config/chromemanager/environment
WorkingDirectory=@@PROJECT@@
ExecStart=@@PYTHON@@ -m chrome_manager.cli browser-run %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
