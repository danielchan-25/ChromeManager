[Unit]
Description=ChromeManager Linux management console
After=network.target chromemanager-relay.service
Wants=chromemanager-relay.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%h/.config/chromemanager/environment
WorkingDirectory=@@PROJECT@@
ExecStart=@@PYTHON@@ -m chrome_manager.cli web
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
