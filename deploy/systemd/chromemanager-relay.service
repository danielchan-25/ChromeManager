[Unit]
Description=ChromeManager independent CDP TCP relay
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%h/.config/chromemanager/environment
WorkingDirectory=@@PROJECT@@
ExecStart=@@PYTHON@@ -m chrome_manager.cli relay
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
